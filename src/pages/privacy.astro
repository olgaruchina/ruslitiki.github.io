---
import Page from '../layouts/Page.astro';
import RichText from '../components/RichText.astro';
import { readContent } from '../lib/content.mjs';
import { labelsFor } from '../lib/labels.mjs';
const content = readContent();
const labels = labelsFor(content);
const label = field => ({content,id:'labels',field,value:labels[field]});
---
<Page title={`${labels.privacy} | ${content.brand}`} description={labels.privacyDescription} content={content} path="/privacy/">
  <div class="reading-page">
    <header><RichText {...label('privacyBack')} as="a" class="back-link" href="/" /></header>
    <main id="main">
      <RichText {...label('privacy')} as="h1" />
      <RichText {...label('privacyIntroduction')} as="p" />
      <RichText {...label('privacyWaitlistHeading')} as="h2" />
      <RichText {...label('privacyWaitlistBody')} as="p" />
      <RichText {...label('privacyOptionalAnswers')} as="p" />
      <p><RichText {...label('privacyGoogleBeforeLink')} /> <RichText {...label('privacyGoogleLink')} as="a" href="https://policies.google.com/privacy" target="_blank" rel="noopener" title={labels.opensNewTab} /> <RichText {...label('privacyGoogleAfterLink')} /></p>
      <RichText {...label('privacyContactHeading')} as="h2" />
      <p><RichText {...label('privacyContactBeforeLink')} /> {content.email ? <RichText {...label('privacyContactEmail')} as="a" href={`mailto:${content.email}`} /> : <RichText {...label('privacyContactInstagram')} as="a" href={content.instagramUrl} target="_blank" rel="noopener" title={labels.opensNewTab} />}<RichText {...label('privacyContactAfterLink')} /></p>
      <RichText {...label('privacyServicesHeading')} as="h2" />
      <p><RichText {...label('privacyYouTubeBeforeLink')} /> <RichText {...label('privacyGoogleLink')} as="a" href="https://policies.google.com/privacy" target="_blank" rel="noopener" title={labels.opensNewTab} /><RichText {...label('privacyYouTubeAfterLink')} /></p>
      <RichText {...label('privacyHosting')} as="p" />
    </main>
  </div>
</Page>

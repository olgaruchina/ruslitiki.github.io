---
import Page from '../layouts/Page.astro';
import { Image } from 'astro:assets';
import oneginArtwork from '../assets/onegin-and-tatyana-1908.jpg';
import { readContent, ctaFor, formatDate } from '../lib/content.mjs';
const content = readContent();
const action = ctaFor(content);
const status = { 'coming-soon': 'Coming soon', 'membership-open': 'Membership is open', reading: 'Reading together' }[content.status];
const sections = content.sections.filter(section => section.visible);
const showOneginArtwork = content.book.showArtwork !== false && content.book.title.trim().toLowerCase() === 'eugene onegin' && content.book.author.trim().toLowerCase() === 'alexander pushkin';
const structuredData = {
  '@context':'https://schema.org',
  '@type':'Organization',
  name:content.brand,
  url:Astro.site?.href,
  description:content.description,
  sameAs:[content.instagramUrl],
  ...(content.email ? {email:content.email} : {}),
};
---
<Page title={content.seo.title} description={content.seo.description}>
  <div class="landing">
    <header class="masthead" aria-label={content.brand}>
      <div class:list={['wordmark', {'wordmark-original': content.logoPresentation === 'original-banner'}]}>
        <img src={content.logo} alt={content.brand} width="2500" height="1000" fetchpriority="high" />
      </div>
      <div class="masthead-meta">
        <p>{content.description}</p>
        <p class="status">{status}<span aria-hidden="true"> ↗</span></p>
      </div>
    </header>
    <main id="main">
      <div class="opening">
        <div class="invitation">
          <h1>{content.heading}</h1>
          <p class="introduction">{content.introduction}</p>
          <a class="join-button" href={action.url}>{action.label}<span aria-hidden="true">↗</span></a>
        </div>
        <aside class="first-book" aria-labelledby="first-book-title">
          <p class="book-label">Our first book</p>
          <h2 id="first-book-title"><i>{content.book.title}</i></h2>
          <p class="author">by {content.book.author}</p>
          {showOneginArtwork && <figure class="book-artwork">
            <Image
              src={oneginArtwork}
              alt="Onegin speaks to Tatyana beside a white bench in a flowering garden."
              widths={[480, 800, 1047]}
              sizes="(min-width: 1440px) 445px, (min-width: 701px) 38vw, calc(100vw - 3rem)"
              format="webp"
              quality={85}
              loading="eager"
              decoding="async"
            />
            <figcaption>
              Onegin and Tatyana. <a href="https://commons.wikimedia.org/wiki/File:Onegin_and_Tatyana.jpg">Elena Samokish-Sudkovskaya, 1908</a>.
            </figcaption>
          </figure>}
          <p class="book-note">{content.book.note}</p>
          <dl class="dates">
            <div><dt>Membership opens</dt><dd><time datetime={content.openingDate}>{formatDate(content.openingDate)}</time></dd></div>
            <div><dt>We start reading</dt><dd><time datetime={content.readingDate}>{formatDate(content.readingDate)}</time></dd></div>
          </dl>
        </aside>
      </div>
      {sections.length > 0 && <div class="extra-sections">{sections.map(section => section.type === 'faq' ? (
        <details><summary>{section.heading}</summary><p>{section.body}</p></details>
      ) : (
        <section><h2>{section.heading}</h2><p>{section.body}</p></section>
      ))}</div>}
    </main>
    <footer class="footer">
      <p>Read. Think. Question. Disagree.</p>
      <nav aria-label="Contact and information">
        <a href={content.instagramUrl}>Instagram<span class="sr-only"> — Ruslitiki</span></a>
        {content.email && <a href={`mailto:${content.email}`}>Contact Olga</a>}
        <a href="/privacy/">Privacy</a>
      </nav>
    </footer>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g,'\\u003c')} />
</Page>

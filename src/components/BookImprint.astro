---
import { getImage } from 'astro:assets';
import openBook from '../assets/book-imprints/open-book.png';
import closedBook from '../assets/book-imprints/closed-book.png';
import bookStack from '../assets/book-imprints/book-stack.png';
const {kind='open',placement}=Astro.props;
const artwork={open:openBook,closed:closedBook,stack:bookStack};
const mask=await getImage({src:artwork[kind],width:384,format:'webp',quality:80});
---
<span class:list={['book-imprint',`imprint-${placement}`]} style={`--book-mask:url('${mask.src}')`} aria-hidden="true"></span>

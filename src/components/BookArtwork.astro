---
import { Image } from 'astro:assets';
import artwork from '../assets/onegin-and-tatyana-1908.jpg';
import { labelsFor } from '../lib/labels.mjs';
import RichText from './RichText.astro';
const {content={},visualEditing=false}=Astro.props;
const labels=labelsFor(content);
---
<figure class="book-artwork">
  <Image src={artwork} alt={labels.artworkAlt} widths={[480,800,1047]} sizes="(min-width: 900px) 45vw, calc(100vw - 3rem)" format="webp" quality={85} loading="eager" decoding="async" />
  <figcaption><RichText content={content} id="labels" field="artworkCaption" value={labels.artworkCaption} visualEditing={visualEditing} /> <RichText content={content} id="labels" field="artworkCredit" value={labels.artworkCredit} as="a" href="https://commons.wikimedia.org/wiki/File:Onegin_and_Tatyana.jpg" target="_blank" rel="noopener" title={labels.opensNewTab} visualEditing={visualEditing} />.</figcaption>
</figure>

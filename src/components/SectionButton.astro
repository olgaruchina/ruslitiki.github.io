---
const {section,visualEditing=false}=Astro.props;
const newTab=section.buttonUrl && section.buttonUrl!=='/' && !section.buttonUrl.startsWith('#') && !section.buttonUrl.startsWith('mailto:');
---
<a class:list={['section-button',`section-button-${section.buttonKind || 'primary'}`]} href={section.buttonUrl || undefined} target={newTab?'_blank':undefined} rel={newTab?'noopener':undefined} title={newTab?'Opens in a new tab':undefined} data-edit-field={visualEditing?'buttonLabel':undefined} data-placeholder={visualEditing?'Button label':undefined}>{section.buttonLabel}</a>

---
import Page from '../layouts/Page.astro';
import Opening from './Opening.astro';
import ContentBlock from './ContentBlock.astro';
import BookImprint from './BookImprint.astro';
import RichText from './RichText.astro';
import Navigation from './Navigation.astro';
import { instagramProfile } from '../lib/content.mjs';
import { designFor, normalizedSections, groupedSections } from '../lib/design.mjs';
import { publicSectionAnchors, hasHowItWorksVideoBookmark } from '../lib/anchors.mjs';
import { labelsFor } from '../lib/labels.mjs';
const {content,visualEditing=false}=Astro.props;
const design=designFor(content);
const sections=new Map(normalizedSections(content.sections).map(section=>[section.id,section]));
const anchors=publicSectionAnchors([...sections.values()]);
const clubVideo=hasHowItWorksVideoBookmark([...sections.values()]);
const labels=labelsFor(content);
const groups=groupedSections(content);
const hostProfile=instagramProfile(content.hostInstagramUrl);
const clubHandle=instagramProfile(content.instagramUrl)?.handle || labels.instagramFallback;
const label=field=>({content,id:'labels',field,value:labels[field],visualEditing});
const structuredData = {
  '@context':'https://schema.org',
  '@type':'Organization',
  name:content.brand,
  url:Astro.site?.href,
  description:content.description,
  sameAs:[content.instagramUrl],
  ...(content.email ? {email:content.email} : {}),
};
---
<Page title={content.seo.title} description={content.seo.description} content={content} noindex={visualEditing}>
  <div class="landing" id="canvas-content" data-book-imprints={design.bookImprints?'on':'off'}>
    <header class="masthead" aria-label={content.brand} tabindex={visualEditing?-1:undefined} data-edit-region={visualEditing?"home":undefined}>
      <BookImprint kind="closed" placement="header" />
      <a href="#main" aria-label={`${content.brand} home`} class:list={['wordmark', {'wordmark-original': content.logoPresentation === 'original-banner'}]}>
        <img src={content.logo} alt={content.brand} width="2500" height="1000" fetchpriority="high" />
      </a>
      <div class="masthead-meta">
        <p><RichText content={content} id="brand" field="description" value={content.description} visualEditing={visualEditing} />{hostProfile && <> (<a href={hostProfile.url} target="_blank" rel="noopener" title={labels.opensNewTab} data-edit-region={visualEditing?'host-instagram':undefined}>{hostProfile.handle}</a>)</>}</p>
      </div>
    </header>
    <Navigation content={content} visualEditing={visualEditing} />
    <main id="main">
      {groups.map(group=>group[0]==='opening' ? <Opening content={content} design={design} visualEditing={visualEditing} /> : group.length>1 ?
        <div class="faq-layout">
          <ContentBlock content={content} section={sections.get(group[0])} anchor={anchors.get(group[0])} visualEditing={visualEditing} />
          <div class="faq-questions">{group.slice(1).map(id=><ContentBlock content={content} section={sections.get(id)} anchor={anchors.get(id)} visualEditing={visualEditing} />)}</div>
        </div> : <ContentBlock content={content} section={sections.get(group[0])} anchor={anchors.get(group[0])} videoAlias={clubVideo && group[0]==='meet-ruslitiki'} suppressLegacyAnchor={clubVideo && group[0]==='how-the-club-works'} visualEditing={visualEditing} />)}
    </main>
    <footer class="footer">
      <p><RichText {...label('footerMotto')} /><BookImprint kind="stack" placement="footer" /></p>
      <nav aria-label={labels.footerNavigation}>
        <a href={content.instagramUrl} target="_blank" rel="noopener" title={labels.opensNewTab} data-edit-region={visualEditing?'club-instagram':undefined}><RichText {...label('instagramPrefix')} /> {clubHandle}<span aria-hidden="true"> ↗</span></a>
        {content.email && <a href={`mailto:${content.email}`}><RichText {...label('contact')} /></a>}
        <a href="/privacy/" target="_blank" rel="noopener" title={labels.opensNewTab}><RichText {...label('privacy')} /></a>
      </nav>
    </footer>
  </div>
  <slot />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g,'\\u003c')} />
</Page>
<script>
  import '../scripts/navigation.js';
  import '../scripts/faq.js';
  import '../scripts/current-section.js';
</script>
